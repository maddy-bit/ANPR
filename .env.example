# ==============================================================================
# SIH26127 City AI Platform - Environment Configuration Template
# Copy this file to .env or .env.local and populate with your secure secrets.
# NEVER commit real credentials to source control.
# ==============================================================================

# --- Backend Configuration ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Ingest HTTP Basic Authentication
INGEST_USERNAME=ingest
# In production (SPRING_PROFILES_ACTIVE=prod), INGEST_PASSWORD is REQUIRED and must not use defaults.
INGEST_PASSWORD=local-dev-ingest-only-not-for-prod

# Database & Redis
DB_URL=jdbc:h2:mem:cityaidb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
DB_USERNAME=sa
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# Allowed CORS & WebSocket Origins (comma-separated, no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Base URL for AI Python Microservice
AI_SERVICE_URL=http://localhost:8000

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Optional: Indian Government Parivahan / VAHAN RC API (via RapidAPI)
# Leave empty for local development (VAHAN queries will safely return 503 "Vehicle Registry Integration Disabled").
RAPIDAPI_KEY=

