# ==============================================================================
# SIH26127 City AI Platform - Environment Configuration Template
# Copy this file to .env and populate with your environment secrets.
# NEVER commit real credentials to source control.
# ==============================================================================

# --- Application Server & Profile ---
SERVER_PORT=8080
# Profiles: 'default' (uses persistent PostgreSQL), 'prod' (strict production mode), 'h2' (isolated in-memory test)
SPRING_PROFILES_ACTIVE=default

# --- Database Configuration (PostgreSQL + PostGIS) ---
# Primary persistent target (e.g. Supabase Session Pooler or local PostgreSQL):
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_secure_database_password
DB_DRIVER=org.postgresql.Driver
DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Connection Pooling (HikariCP optimized for session pooling)
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=10000
DB_POOL_MAX_LIFETIME=1800000

# --- Redis Distributed Cache ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Ingest Authentication (HTTP Basic) ---
INGEST_USERNAME=ingest
# In production (SPRING_PROFILES_ACTIVE=prod), INGEST_PASSWORD is REQUIRED and must not use default values.
INGEST_PASSWORD=local-dev-ingest-only-not-for-prod

# --- Network Security & CORS ---
# Allowed CORS origins (comma-separated, explicit protocol and host, no wildcards in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Microservice Interconnect ---
# Base URL for AI Python Microservice (FastAPI on port 8000)
AI_SERVICE_URL=http://localhost:8000
# Backend URL called by AI service during detection ingestion sync
BACKEND_URL=http://localhost:8080

# --- Evidence Storage & Demodata ---
DATA_DIR=../data
EVIDENCE_DIR=../data/evidence
VIDEOS_DIR=../videos
SEED_CAMERAS=false
MOCK_REGISTRY_ENABLED=false

# --- Video Upload & Storage Pipeline (Phase A3) ---
# Storage provider: 'local' (default durable filesystem) or 'supabase' (private cloud bucket)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=../data/uploads
STORAGE_MAX_FILE_SIZE_MB=500

# Supabase Storage (Required only when STORAGE_PROVIDER=supabase)
# Uses private bucket with backend service-role key; never exposed to browser
SUPABASE_STORAGE_URL=https://xzhblfqmjxywoileaopa.supabase.co/storage/v1
SUPABASE_STORAGE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=cctv-uploads

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000

# Optional: Indian Government Parivahan / VAHAN RC API (via RapidAPI)
# Leave empty for local development (VAHAN queries will safely return 503 "Vehicle Registry Integration Disabled").
RAPIDAPI_KEY=
